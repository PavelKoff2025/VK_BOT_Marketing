# Токен сообщества ВКонтакте (управление → работа с API)
VK_TOKEN=vk1.a.xxxxxxxx

# Ключ ProxyAPI.ru (поддерживаются оба имени переменной)
PROXY_API_KEY=sk-xxxxxxxx
# PROXI_API_KEY=sk-xxxxxxxx

# Модель Gemini через ProxyAPI
GEMINI_MODEL=gemini-2.5-flash

# Базовый URL Google API через ProxyAPI
PROXYAPI_GOOGLE_BASE_URL=https://api.proxyapi.ru/google

# Лимиты
MAX_HISTORY_MESSAGES=100
MAX_MESSAGE_LENGTH=3500
